# Optional, reversible scheduling/frequency experiment for star / SM8350.
# WALT, uclamp, the energy model, and schedutil are already present in the
# Lahaina QGKI baseline; state them explicitly and use schedutil only as the
# fallback governor when Android userspace does not select another governor.
CONFIG_SCHED_WALT=y
CONFIG_UCLAMP_TASK=y
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
