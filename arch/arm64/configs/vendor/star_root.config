# Mi 11 Ultra (star) Android 14 / Linux 5.4.274 root build
# ReSukiSU is built into the kernel; 32-bit compatibility hooks are retained.
CONFIG_LOCALVERSION="-qgki-g4dfe63e0666f"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y
# Optional root concealment (SUSFS) is intentionally not enabled.
