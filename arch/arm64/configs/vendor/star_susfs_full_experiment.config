# Experimental full SUSFS profile for Xiaomi Mi 11 Ultra (star) / SM8350.
# Never used by the stable build script; build output must go to a separate O= dir.
# This enables all SUSFS v2.1.0 feature gates for compile-only experimentation.
# SUSFS source/license provenance is not yet established as GPL-2.0-only compatible;
# do not distribute or flash artifacts from this profile pending that review.
# Goodix FOD DRM workaround is source-defined in gf_spi.h, not a Kconfig symbol.
# Inline-hook checks may flag dormant manual-hook guards retained for other profiles.
CONFIG_LOCALVERSION="-qgki-susfs-exp"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KSU=y
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_MANUAL_HOOK is not set
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# Scheduler/storage/input options validated in the separate feature profile.
CONFIG_SCHED_WALT=y
CONFIG_UCLAMP_TASK=y
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_FOD=m
CONFIG_EXFAT_FS=y
